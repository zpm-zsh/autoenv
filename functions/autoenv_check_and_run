#!/usr/bin/env zsh

emulate -L zsh -o no_auto_pushd

echo -e "${c[green]}> ${c[red]}${c[blink]}WARNING${c[reset]}"
echo -ne "${c[green]}> ${c[blue]}This is the first time you are about to source "
echo -e "${c[yellow]}\"${c[red]}${c[bold]}$1${c[yellow]}\"${c[reset]}"
echo
echo -e "${c[green]}----------------${c[reset]}"

if (( $+commands[bat] )); then
  echo
  bat --style='plain' -l bash --paging='never' "$1"
else
  echo -e "${c[green]}"
  cat "$1"
fi

echo -e "${c[green]}----------------${c[reset]}"
echo
echo -ne "${c[blue]}Are you sure you want to allow this? "
echo -ne "${c[cyan]}(${c[green]}y${c[cyan]}/${c[red]}N${c[cyan]}) ${c[reset]}"

read -r answer
if [[ "$answer" == "y" || "$answer" == "Y" || "$answer" == "yes" ]]; then
  echo "$1:$2" >> "$AUTOENV_AUTH_FILE"
  envfile=$1
  shift
  shift
  {
    local -Pr _autoenv_saved_pwd=$PWD || return
    local -Pr _autoenv_saved_oldpwd=$OLDPWD || return
    local AUTOENV_IN_ENVFILE=1
    builtin cd -q "${envfile:h}" || return
    builtin source "$envfile" "$@" || return
  } always {
    # Assigning OLDPWD is not enough: zsh tracks the previous directory
    # internally for `cd -`, and that record is not read back from the
    # parameter. Return via the saved OLDPWD so the internal record ends up
    # correct too.
    [[ -n $_autoenv_saved_oldpwd ]] && builtin cd -q "$_autoenv_saved_oldpwd" 2>/dev/null
    builtin cd -q "$_autoenv_saved_pwd"
    OLDPWD=$_autoenv_saved_oldpwd
  }
fi
