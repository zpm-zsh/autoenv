#!/usr/bin/env zsh

emulate -L zsh -o no_auto_pushd

local IFS=$' \t\n'

if (( $+commands[shasum] )) &> /dev/null; then
  hash=$(shasum "$1" | cut -d' ' -f 1)
else
  hash=$(sha1sum "$1" | cut -d' ' -f 1)
fi

local envfile="$1"
local envdir="${envfile:h}"
shift
if grep -q "$envfile:$hash" "$AUTOENV_AUTH_FILE"; then
  local _autoenv_saved_pwd=$PWD
  local _autoenv_saved_oldpwd=$OLDPWD
  add-zsh-hook -d chpwd autoenv_chdir
  builtin cd -q "$envdir"
  builtin source "$envfile" "$@"
  builtin cd -q "$_autoenv_saved_pwd"
  OLDPWD=$_autoenv_saved_oldpwd
  add-zsh-hook chpwd autoenv_chdir
else
  echo
  autoenv_check_and_run "$envfile" "$hash" "$@"
fi
