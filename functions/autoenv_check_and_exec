#!/usr/bin/env zsh

emulate -L zsh -o no_auto_pushd
zmodload zsh/param/private

local IFS=$' \t\n'

local hash
if (( $+commands[shasum] )); then
  hash=$(shasum "$1" | cut -d' ' -f 1)
else
  hash=$(sha1sum "$1" | cut -d' ' -f 1)
fi

local envfile="$1"
shift
# -x -F: the authorization file holds whole "path:hash" lines. Without them the
# path is a regular expression matched against any part of the line, so a
# directory named to match an authorized one -- `a.c` against `abc` -- would be
# sourced without asking. Same content, but from the attacker's directory, and
# envfiles resolve their paths relative to themselves.
if grep -qxF -- "$envfile:$hash" "$AUTOENV_AUTH_FILE"; then
  {
    local -Pr _autoenv_saved_pwd=$PWD || return
    local -Pr _autoenv_saved_oldpwd=$OLDPWD || return
    local AUTOENV_IN_ENVFILE=1
    builtin source "$envfile" "$@" || return
  } always {
    # An envfile may cd, but it must not move the user: the walk through the
    # path components was computed before it ran, and wherever it landed has
    # not been processed. Nothing to undo in the usual case.
    if [[ $PWD != $_autoenv_saved_pwd ]]; then
      # Assigning OLDPWD is not enough: zsh tracks the previous directory
      # internally for `cd -`, and that record is not read back from the
      # parameter. Return via the saved OLDPWD so the internal record ends up
      # correct too.
      [[ -n $_autoenv_saved_oldpwd ]] && builtin cd -q "$_autoenv_saved_oldpwd" 2>/dev/null
      builtin cd -q "$_autoenv_saved_pwd"
      OLDPWD=$_autoenv_saved_oldpwd
    fi
  }
else
  echo
  autoenv_check_and_run "$envfile" "$hash" "$@"
fi
